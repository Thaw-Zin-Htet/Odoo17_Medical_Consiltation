<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Appointment Form View -->
    <record id="view_consultation_appointment_form" model="ir.ui.view">
        <field name="name">consultation.appointment.form</field>
        <field name="model">consultation.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment Form">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark as Done" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>

                    <!-- New Button For Invoice Generation -->
                    <button name="create_invoice" string="Generate Invoice" type="object" class="oe_highlight" invisible="state != 'done' or invoice_id"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <!-- New: Smart Button Box to link to accounting -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not invoice_id">
                            <field name="invoice_id" widget="statinfo" string="Invoice"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Appointment Details">
                            <field name="patient_id"/>
                            <field name="phone_number"/>
                            <field name="department_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group string="Appointment Timing">
                            <field name="appointment_date"/>
                            <field name="consultation_type" widget="radio"/>
                            <field name="meeting_url" widget="url" invisible="consultation_type != 'video_call'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prescription &amp; Treatments">
                            <field name="prescription_line_ids">
                                <tree editable="bottom">
                                    <field name="medicine_name"/>
                                    <field name="dosage"/>
                                    <field name="frequency"/>
                                    <field name="duration_days"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Appointment Tree View -->
    <record id="view_consultation_appointment_tree" model="ir.ui.view">
        <field name="name">consultation.appointment.tree</field>
        <field name="model">consultation.appointment</field>
        <field name="arch" type="xml">
            <tree string="Appointment Tree">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="consultation_type"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'confirmed'" decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Appointment Search View -->
    <record id="view_consultation_appointment_search" model="ir.ui.view">
        <field name="name">consultation.appointment.search</field>
        <field name="model">consultation.appointment</field>
        <field name="arch" type="xml">
            <search string="Search Appointments">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="department_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Patient" name="group_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Doctor" name="group_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Appointment Action -->
    <record id="action_consultation_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">consultation.appointment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain" eval="False"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first appointment
            </p>
        </field>
    </record>

</odoo>
