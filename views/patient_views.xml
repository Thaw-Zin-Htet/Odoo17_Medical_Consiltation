<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Patient Form View -->
    <record id="view_consultation_patient_form" model="ir.ui.view">
        <field name="name">consultation.patient.form</field>
        <field name="model">consultation.patient</field>
        <field name="arch" type="xml">
            <form string="Patient Form">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Patient Full Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="gender"/>
                            <field name="dob"/>
                            <field name="age"/>
                            <field name="blood_group"/>
                        </group>
                        <group string="Contact Details">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="address"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Patient Tree View -->
    <record id="view_consultation_patient_tree" model="ir.ui.view">
        <field name="name">consultation.patient.tree</field>
        <field name="model">consultation.patient</field>
        <field name="arch" type="xml">
            <tree string="Patient Tree">
                <field name="name"/>
                <field name="gender"/>
                <field name="dob"/>
                <field name="age"/>
                <field name="phone"/>
                <field name="blood_group"/>
            </tree>
        </field>
    </record>

    <!-- Patient Action -->
    <record id="action_consultation_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">consultation.patient</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
